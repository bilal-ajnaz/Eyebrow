# App Store link — paste it here once the app is live.
NEXT_PUBLIC_APP_STORE_URL=

# Optional: real email delivery for the support form.
# Without this the form falls back to opening the visitor's mail client.
# Free tier, no card required: https://resend.com
RESEND_API_KEY=
# Must be a domain you verified in Resend (or onboarding@resend.dev for testing).
SUPPORT_FROM_EMAIL=onboarding@resend.dev
